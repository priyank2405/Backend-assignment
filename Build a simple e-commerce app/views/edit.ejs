<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit product</title>
</head>
<body>
   <div>
      <h2>Edit your product details</h2>
   </div> 



   <div>
    <form action="/shop/<%= product.id %>/edit" method="post">
        <input type="text" value="<%= product.image %>"  name="image" placeholder="enter the image Url">
        <input type="text" value="<%= product.name %>" name="name" placeholder="enter your name">
        <input type="text" value="<%= product.description %>" name="description" placeholder="enter the product desc">
        <input type="number" value="<%= product.price %>" name="price" placeholder="enter the Price">

        <button type="submit">Edit product</button>
    </form>
   </div>

   <div>
    <a href="/shop">Back to Shop</a>
   </div>

</body>
</html>