<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>my app</title>
</head>
<body>
    <div>
        <h2>Manage your expenses</h2>
    </div>
   
    <div>
        <% expenses.forEach( expense => {  %>
           <h3> <%= expense.title %> </h3>
           <p>Amount: $<%= expense.amount %></p>
           <p>Category: <%= expense.category %></p>
           <p>Date: <%= expense.date %></p>
    
           <form action="/app/<%= expense.id %>/edit" method="get">
                <button type="submit">edit</button>
            </form>
            <form action="/app/<%= expense.id %>/delete" method="post">
                <button type="submit">Delete</button>
            </form>

            <% }) %>
                
    </div>
    <div>
        <form action="/app" method="post">
          <input type="text" name="title" placeholder="Enter title">
          <input type="number" name="amount" placeholder="Enter the amount">
          <input type="text" name="category" placeholder="Enter the category">
          <input type="date" name="date" placeholder="Enter the date">

          <button type="submit">Create expense</button>
        </form>
    </div>
</body>
</html>