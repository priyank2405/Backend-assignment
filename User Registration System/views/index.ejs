<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Error</title>
    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <body>
    <div>
        <h1 class="text-5xl font-bold text-center text-red-500 mt-3">User Management System</h1>
    </div>
    <div class="border py-3 mt-5">
      <div class="flex justify-between max-w-5xl mx-auto item-center">
        <a href="/" class="text-lg">User Management</a>
        <a href="/add" class="hover:text-blue-400">Add User</a>
      </div>
    </div>


    <div class="mt-20 max-w-sm mx-auto">
        <% if(usersCount == 0) {%>
            <h1 class="text-xl font-bold ">No users available</h1>
            <p class="text-sm">Lorem ipsum dolor sit amet consectetur adipisicing elit. Non, excepturi!</p>
            <a href="/add" class="bg-black text-white px-5 py-3 mt-2 inline-block">Add Users</a>
        <% }  else {%>
             <h1 class="text-xl font-bold ">Users available</h1>
            <p class="text-sm">Lorem ipsum dolor sit amet consectetur adipisicing elit. Non, excepturi!</p>
            <% for(let i=0; i<users.length; i++) {%>
                <div class="flex justify-between item-center mt-2">
                 <div class="flex gap-2 item-center mb-1">
                    <img src="<%= users[i].img %>" alt="" class="h-10 w-10 rounded-full object-cover">
                    <div><%= users[i].name %></div>
                    <div><%= users[i].email %></div>
                 </div>
                 <div class="flex gap-4 item-center">
                    <form action="/delete" method="post" class="inline">
                    <input type="hidden" name="userId" value="<%= i %>">
                    <button type="submit">Delete</button>
                  </form>
                 </div>
                </div>
           <% } %>
           <% } %>               
     </div>
  </body>
</html>
