<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Error</title>
    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <body>
   
    <div class="border-b py-3">
      <div class="flex justify-between max-w-5xl mx-auto item-center">
        <a href="/" class="text-lg ">User Management</a>
        <a href="/add" class="hover:text-blue-400">Add User</a>
      </div>
    </div>

    <div class="mt-44 max-w-sm mx-auto">
        <h1 class="text-2xl font-bold">update details of <%= user.name%></h1>
        <p>Lorem ipsum dolor sit amet consectetur adipisicing elit. Accusantium, expedita.    
        </p>

        <form action="/update-user" method="post">
            <input type="hidden" name="userId" value="<%= userId %>">
            <input value="<%=user.name%>" type="text" name="name" placeholder="Enter your name" required class="mt-5 mb-2 p-3 border border-neutral-300 w-full focus:outline-none focus:border-blue-600">
            <input value="<%=user.email%>" type="text" name="email" placeholder="Enter your email" required class=" mb-2 p-3 border border-neutral-300 w-full focus:outline-none focus:border-blue-600">
            <input value="<%=user.img%>" type="text" name="img" placeholder="Enter image URL" required class="mb-2 p-3 border border-neutral-300 w-full focus:outline-none focus:border-blue-600">
            <button class="bg-black text-white px-5 py-3">Update user</button>
        </form>
    </div>

    
  </body>
</html>